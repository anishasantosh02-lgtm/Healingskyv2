# ============================================================
# Dynamic LLM Provider Selection
# Options: "anthropic" | "azure" | "openai" | "custom"
# ============================================================

LLM_PROVIDER=anthropic

# ============================================================
# Anthropic Claude Configuration
# ============================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# Standard OpenAI Configuration
# ============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# Azure OpenAI Configuration
# ============================================================
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name

# ============================================================
# Custom / Local OpenAI-Compatible LLM (Ollama, Groq, DeepSeek, etc.)
# ============================================================
CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
CUSTOM_LLM_API_KEY=dummy-key
CUSTOM_LLM_MODEL=llama3.2

# ============================================================
# Browser Test Configuration
# ============================================================
# HEADLESS=true with SLOW_MO=0 is roughly 3x faster, for CI.
# HEADLESS=false with SLOW_MO=250 to watch the run in a real browser.
HEADLESS=false
SLOW_MO=250
AGENT_MAX_STEPS=40

# Draws a cursor, click ripple and element outline for every action.
# Defaults to on whenever HEADLESS=false. Set false to disable.
VISUAL_CLICKS=true

# ============================================================
# Viewport
# ============================================================
# Leave unset for headed runs, so the browser uses its real maximized
# window size and the page stays correctly aligned. Forcing a viewport
# wider than the window pushes the header buttons off the right edge;
# forcing one taller makes the browser look cropped.
#
# Set both for headless/CI runs, where a tall viewport lets a whole
# long form be captured in one screenshot.
# ============================================================
# VIEWPORT_WIDTH=1440
# VIEWPORT_HEIGHT=1400

# ============================================================
# Login Credentials (resolved locally, never sent to the LLM)
# ============================================================
CLIENT_TEST_EMAIL=mithu@yopmail.com
CLIENT_TEST_OTP=1234

# ============================================================
# Dynamic Registration Test Data
# ============================================================
# All values below are generated fresh on every run.
# Uncomment any of them to pin a value and make a run reproducible.
# ============================================================
TEST_EMAIL_DOMAIN=yopmail.com
TEST_REFERRAL_CODE=NAN5EM09
TEST_PHONE_COUNTRY_CODE=+1
TEST_PHONE_COUNTRY_LABEL=United States (+1)
TEST_DOB_MONTH=June
TEST_DOB_DATE=4
TEST_DOB_YEAR=1999
# TEST_FULL_NAME=Alex Morgan
# TEST_EMAIL=alex.morgan@yopmail.com
# TEST_PHONE_NUMBER=2025550143
# TEST_ADDRESS=1 Wall St, New York, NY  
